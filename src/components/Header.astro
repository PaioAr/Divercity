---
import { asset } from '../lib/url.js';
const links = [
  ['La nota', '#nota'], ['Antes y después', '#antes-despues'], ['El equipo', '#equipo'],
];
---
<header class="sticky top-0 z-50 bg-navy text-white">
  <div class="mx-auto flex max-w-[80rem] items-center gap-4 px-5 py-3 lg:px-10">
    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none p-1" aria-label="Abrir menú">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </summary>
      <div class="absolute left-0 top-full mt-3 w-56 rounded-2xl bg-white p-3 text-navy shadow-xl">
        {links.map(([t, h]) => <a href={h} class="block rounded-lg px-3 py-2 font-medium hover:bg-cream">{t}</a>)}
      </div>
    </details>
    <a href="#" aria-label="Divercity, inicio"><img src={asset('/img/logo-blanco.png')} alt="Divercity - Accesibilidad para todos" class="h-12 w-auto" /></a>
    <nav class="ml-auto hidden items-center gap-7 text-sm font-semibold lg:flex" aria-label="Principal">
      {links.map(([t, h]) => <a href={h} class="border-b-2 border-transparent py-1 hover:border-gold">{t}</a>)}
    </nav>
  </div>
</header>